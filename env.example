# --- 伺服器設定 ---
PORT=8000

# --- Slack 整合設定 (HTTP Webhook 模式) ---
# Bot User OAuth Token (以 xoxb- 開頭)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# App Signing Secret (用於 Webhook 請求驗簽)
SLACK_SIGNING_SECRET=your-slack-app-signing-secret
# 限制觸發的 Slack 頻道 ID (slash command 必填，留空會讓四個 slash command 一律拒絕；@mention 留空則不限制頻道)
SLACK_ALLOWED_CHANNEL_ID=CXXXXXXXX
# 是否啟用 Thread 歷史紀錄抓取，預設關閉為 False (僅抓取觸發訊息本身)
ENABLE_THREAD_HISTORY=False


# --- Trello API 設定 ---
# 前往 https://trello.com/power-ups/admin/ 建立 Power-Up 以取得 API Key 與 Token，或向系統管理員索取
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_TOKEN=your-trello-api-token
# 看板 ID (從看板網址.json 取得)
TRELLO_BOARD_ID=your-trello-board-id


# --- 整流器設定 ---
# 運行環境，支援 test / prod
RECTIFIER_ENV=test
# Slack 通知路徑
RECTIFIER_NOTIFY_PATH=default_notify_path
# 本地端是否在 rectifier 成功後額外輸出 request/response 到指定 JSONL 檔，支援 true / false (預設為 false)
MOCK_SLACK_OUTPUT=false
# 啟用 MOCK_SLACK_OUTPUT 後的輸出檔案路徑
MOCK_SLACK_OUTPUT_PATH=./tmp/mock_slack_output.jsonl


# --- Google Drive API 設定 ---
# OAuth 使用者憑證路徑；Service Account 已不再使用（見 drive_tool._get_all_drive_services）
GOOGLE_DRIVE_TOKEN_PATH=./credentials/token.json

#--- 文件路徑設定 ---
WIKI_STATIC_PATH=/path/to/SlackAIAgent/wiki/docs
WIKI_BASE_URL=https://rd.agent.leju.trade/wiki

# /mcp/wiki 的金鑰是一人一把，存在 backend/credentials/wiki_mcp_keys.json
# （已在 .gitignore 排除），不是環境變數；用 scripts/manage_wiki_mcp_keys.py
# 核發/撤銷，不需要在這裡設定任何東西


# github Personal Access Token (PAT) for reading GitHub repository content and checking file access
GITHUB_PAT=your-github-fine-grained-personal-access-token

# github access token for accepting only repository invitations referenced by the current Slack GitHub URLs
# Classic tokens require repo:invite or repo scope for invitation acceptance.
GITHUB_ACCESS_TOKEN=your-github-access-token

# Claude path
CLAUDE_BIN=/path/to/claude

#Dashboard

METRICS_DB_HOST=your-hostname
METRICS_DB_PORT=xxx
METRICS_DB_NAME=your-name
METRICS_DB_USER=user
METRICS_DB_PASSWORD=your-password
# 連線逾時秒數，預設 5；設太大會讓 DB 不可用時拖住整個請求
METRICS_DB_CONNECT_TIMEOUT=5
GRAFANA_ADMIN_PASSWORD=your-password
